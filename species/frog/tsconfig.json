{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "noFallthroughCasesInSwitch": true,
    "declaration": true, "declarationMap": false, "sourceMap": false,
    "rootDir": "src", "outDir": "generated", "skipLibCheck": false
  },
  "include": ["src/**/*.mts"]
}
