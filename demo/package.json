{
  "name": "ascii-animals-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.private-renderers.json && next dev --webpack",
    "build": "npm --prefix .. run build && npm run build:site",
    "build:site": "tsc -p tsconfig.private-renderers.json && next build --webpack && node scripts/finalize-export.mjs && node scripts/check-export.mjs",
    "typecheck": "tsc --noEmit",
    "check:export": "node scripts/check-export.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "generate:social": "node scripts/generate-social-preview.mjs",
    "serve": "node scripts/serve-export.mjs",
    "test": "playwright test",
    "test:static": "node --test tests/export.test.mjs tests/seo.test.mjs",
    "test:unit": "node --test tests/export.test.mjs tests/renderers.test.mjs tests/seo.test.mjs tests/ink-puppet-adapter.test.mjs",
    "test:seo": "playwright test tests/seo.spec.ts"
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "ascii-animals-review": "file:..",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
