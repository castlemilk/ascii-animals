{
  "name": "ascii-animals-review",
  "version": "0.0.0-review.0",
  "description": "Local review candidate for a framework-neutral procedural ASCII animals library",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./cuttlefish": {
      "types": "./lib/animals/cuttlefish.d.ts",
      "import": "./lib/animals/cuttlefish.js",
      "default": "./lib/animals/cuttlefish.js"
    },
    "./core": {
      "types": "./lib/core/index.d.ts",
      "import": "./lib/core/index.js",
      "default": "./lib/core/index.js"
    },
    "./fox": {
      "types": "./lib/public/fox.d.ts",
      "import": "./lib/public/fox.js",
      "default": "./lib/public/fox.js"
    },
    "./owl": {
      "types": "./lib/public/owl.d.ts",
      "import": "./lib/public/owl.js",
      "default": "./lib/public/owl.js"
    }
  },
  "sideEffects": false,
  "files": [
    "lib/",
    "README.md",
    "NOTICE.md",
    "docs/*.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs species/fox/tests/*.test.mjs species/owl/tests/*.test.mjs",
    "test:legacy": "node scripts/check-engine.cjs",
    "bench:cpu": "node bench/benchmark.cjs --source src/animals/cuttlefish.js --esm --out artifacts/benchmark.json",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "node -e \"throw new Error('Review candidate: publication is intentionally disabled')\"",
    "pretest": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p species/fox/tsconfig.types.json && tsc -p species/owl/tsconfig.types.json",
    "test:fox": "node node_modules/typescript/bin/tsc -p species/fox/tsconfig.types.json && node --test species/fox/tests/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/castlemilk/ascii-animals.git"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
